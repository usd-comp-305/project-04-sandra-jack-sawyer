@startuml
'https://plantuml.com/class-diagram

abstract class Character {
    name: str
    type: characterType
    health: int
    attackPower: int
    defensePower: int
    speed: int
    equippedWeapon: Weapon
    equippedArmor: Armor

    takeDamage(): void
    attack(): void
    isAlive(): boolean
    chooseAction(): Action
}

class NPC extends Character {

}

class PlayableCharacter extends Character {

}

abstract class EventFactory {
    createEvent(): Event
}

abstract class Event {
    eventName: str
}

class Battle extends Event {
    allies: List<alliedNPC>
    enemies: List<enemyNPC>
}

class Encounter extends Event{
    location: str
    items: List<Item>
}

enum characterType {
    MAN
    ELF
    DWARF
    HOBBIT
    WIZARD
    ORC
    TROLL
    DRAGON
    NAZGUL
}

class Game {
    player: Character
    setting: Event
    team: List<alliedNPC>
    progress: int

    startGame(): void
    updateProgress(): void
    endGame(): void
    selectCharacter(): Character
}

abstract class Item {
    name: str

    abstract use(): void
}

class Weapon extends Item {
    damage: int
}

class Armor extends Item {
    defense: int

    calculateDamage(): int
}

class Consumable extends Item {
    healthRestore: int
    usesRemaining: int

    isDepleted(): bool
}

class Action {

}


Game --> EventFactory
Game --> Character

Character --> characterType
Character *-- Weapon
Character *-- Armor
Character --> Action

EventFactory --> Event

@enduml